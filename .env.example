# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# Postgres connection string from Neon (Neon Console -> Connect -> "Pooled connection")
DATABASE_URL=postgresql://neondb_owner:password@ep-example-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Random secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The frontend origin allowed to call this API with cookies
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
PORT=5000
